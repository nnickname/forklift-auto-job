/**
 * SA-MP 0.3DL Auto Forklift Job - ASI Plugin
 * Purpose: Testing anticheat detection capabilities
 * 
 * Uses a dedicated thread. SA-MP 0.3.DL R1.
 */

#include <windows.h>
#include <stdio.h>
#include "samp.h"
#include "game.h"
#include "forklift.h"
#include "raknet_hook.h"

// ============================================================
// Globals
// ============================================================
static bool g_ModActive = false;
static bool g_Running   = true;
static HANDLE g_Thread  = NULL;

// ============================================================
// Keyboard toggle (F5)
// ============================================================
static void CheckToggle() {
    static bool keyWasDown = false;
    bool keyIsDown = (GetAsyncKeyState(VK_F5) & 0x8000) != 0;

    if (keyIsDown && !keyWasDown) {
        g_ModActive = !g_ModActive;

        if (g_ModActive) {
            Beep(1000, 150);
            Game::Log("[F5] Mod ACTIVADO");
        } else {
            Beep(400, 150);
            Game::Log("[F5] Mod DESACTIVADO");
            Forklift::Reset();
        }

        // Chat message (safe)
        __try {
            if (g_ModActive)
                Game::AddChatMessage(0xFF00FF00, "[Forklift] {FFFFFF}Mod ACTIVADO - F5 para desactivar");
            else
                Game::AddChatMessage(0xFFFF0000, "[Forklift] {FFFFFF}Mod DESACTIVADO");
        } __except(EXCEPTION_EXECUTE_HANDLER) {}
    }
    keyWasDown = keyIsDown;
}

// ============================================================
// Main Thread
// ============================================================
static DWORD WINAPI MainThread(LPVOID lpParam) {
    Game::Log("=== Forklift Plugin iniciado (Thread) ===");

    // Wait for game + SA-MP to fully load
    Sleep(15000);
    Game::Log("Espera inicial completada.");

    // Try to confirm SA-MP is loaded
    bool sampReady = false;
    for (int i = 0; i < 150; i++) { // up to 15 more seconds
        __try {
            if (SAMP::IsInitialized()) {
                sampReady = true;
                break;
            }
        } __except(EXCEPTION_EXECUTE_HANDLER) {}
        Sleep(100);
    }

    if (sampReady) {
        Game::Log("SA-MP 0.3.DL detectado y conectado.");
        
        // Log samp.dll base for debugging offsets
        DWORD sampBase = SAMPOffsets::GetSAMPBase();
        char baseBuf[128];
        snprintf(baseBuf, sizeof(baseBuf), "samp.dll base = 0x%lX", sampBase);
        Game::Log(baseBuf);
        
        Game::Log("Plugin listo. Presiona F5 para activar.");
    } else {
        Game::Log("WARNING: SA-MP no detectado o no conectado. Continuando...");
    }

    // Ready beep
    Beep(800, 100);
    Sleep(100);
    Beep(800, 100);

    // ========================
    // MAIN LOOP
    // ========================
    while (g_Running) {
        __try {
            CheckToggle();
        } __except(EXCEPTION_EXECUTE_HANDLER) {}

        if (g_ModActive) {
            // Throttled debug log
            static DWORD lastDbg = 0;
            DWORD now = GetTickCount();
            if (now - lastDbg > 3000) {
                lastDbg = now;
                __try {
                    DWORD ped = Game::GetPlayerPed();
                    bool inVeh = Game::IsPlayerInVehicle();
                    bool cpOK = Game::IsCheckpointActive();
                    bool rcpOK = Game::IsRaceCheckpointActive();

                    float px = 0, py = 0, pz = 0;
                    if (ped) {
                        Game::Vec3 p = Game::GetPlayerPosition();
                        px = p.x; py = p.y; pz = p.z;
                    }

                    float cx = 0, cy = 0, cz = 0;
                    if (cpOK) {
                        // Game::Vec3 c = Game::GetCheckpointPosition(); // DISABLED: Returns garbage often
                        // cx = c.x; cy = c.y; cz = c.z;
                    } else if (rcpOK) {
                        // Game::Vec3 c = Game::GetRaceCheckpointPosition();
                        // cx = c.x; cy = c.y; cz = c.z;
                    }

                    char dbg[512];
                    snprintf(dbg, sizeof(dbg),
                        "[DBG] State=%d Ped=0x%lX InVeh=%d CP=%d RCP=%d Pos=(%.1f,%.1f,%.1f)",
                        (int)Forklift::GetState(), ped, inVeh ? 1 : 0,
                        cpOK ? 1 : 0, rcpOK ? 1 : 0,
                        px, py, pz);
                    Game::Log(dbg);
                } __except(EXCEPTION_EXECUTE_HANDLER) {
                    Game::Log("[DBG] Exception reading game state");
                }
            }

            // Logic
            __try {
                bool inVeh = Game::IsPlayerInVehicle();
                if (inVeh) {
                    Forklift::Update();
                    if (sampReady) {
                        RakNetHook::Update();
                    }
                } else {
                    // Si se cayó del vehículo durante TP, resetear estado
                    auto st = Forklift::GetState();
                    if (st == Forklift::State::TELEPORTING_PICKUP || 
                        st == Forklift::State::TELEPORTING_DELIVERY) {
                        Game::Log("[MAIN] Jugador fuera del vehiculo durante TP! Reseteando.");
                        Game::AddChatMessage(0xFFFF0000, "[Forklift] {FFFFFF}Te caiste del vehiculo! Reseteando...");
                        Forklift::Reset();
                    }
                }
            } __except(EXCEPTION_EXECUTE_HANDLER) {}
        }

        Sleep(50); // ~20 ticks/sec
    }

    Game::Log("=== Plugin finalizado ===");
    return 0;
}

// ============================================================
// DLL Entry Point
// ============================================================
BOOL APIENTRY DllMain(HMODULE hModule, DWORD reason, LPVOID reserved) {
    switch (reason) {
        case DLL_PROCESS_ATTACH:
            DisableThreadLibraryCalls(hModule);
            g_Thread = CreateThread(NULL, 0, MainThread, NULL, 0, NULL);
            break;

        case DLL_PROCESS_DETACH:
            g_Running = false;
            if (g_Thread) {
                WaitForSingleObject(g_Thread, 2000);
                CloseHandle(g_Thread);
            }
            break;
    }
    return TRUE;
}
